{
  "name": "leaf-rpa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "build-pro": "npm run build && npm run tauri build",
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "setup-python": "node scripts/setup-python.mjs",
    "verify:plugin": "node scripts/verify-content.cjs",
    "check:emoji": "node scripts/check-emoji.mjs",
    "check:emoji:log": "node scripts/check-emoji.mjs --log",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "vue-tsc --noEmit --strict",
    "lint:rust": "cd src-tauri && cargo clippy --lib -- -W clippy::all -W clippy::pedantic -W clippy::nursery -D warnings",
    "lint:all": "npm run build && npm run lint && npm run lint:rust",
    "clean": "node -e \"['node_modules','dist','src-tauri/target'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}})\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.12.4",
    "element-plus": "^2.14.8",
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
