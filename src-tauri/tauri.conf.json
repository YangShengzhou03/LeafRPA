{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leaf RPA",
  "version": "0.1.0",
  "identifier": "com.leaf-rpa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻羽RPA",
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": false,
        "width": 1392,
        "height": 824,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python": "python",
      "../python-runtime": "python-runtime",
      "../plugin": "plugin"
    }
  }
}
